# docker-compose.yml 용 환경 변수. 서버에서 `.env`로 복사해 값을 채운다.
# .env 는 커밋하지 않는다 (.gitignore 등록됨).

POSTGRES_DB=archive
POSTGRES_USER=archive
POSTGRES_PASSWORD=

# 호스트 쪽 포트. 서버에 다른 Postgres 가 이미 떠 있으면 여기서 비켜준다.
# 컨테이너 내부는 항상 5432 이므로 이 값만 바꾸면 된다.
POSTGRES_PORT=5434
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# MinIO 루트 자격. 비밀번호는 8자 이상.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# 단일 버킷. 원본/파생물은 접두사로 구분한다 (originals/, derivatives/).
S3_BUCKET=archive
